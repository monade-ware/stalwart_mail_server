{
  "server": {
    "hostname": "localhost",
    "listener": {
      "smtp": {
        "bind": ["0.0.0.0:25"],
        "tls": { "implicit": false }
      },
      "submission": {
        "bind": ["0.0.0.0:587"],
        "tls": { "implicit": false }
      },
      "submissions": {
        "bind": ["0.0.0.0:465"],
        "tls": { "implicit": true }
      },
      "imap": {
        "bind": ["0.0.0.0:143"],
        "tls": { "implicit": false }
      },
      "imaps": {
        "bind": ["0.0.0.0:993"],
        "tls": { "implicit": true }
      },
      "pop3": {
        "bind": ["0.0.0.0:110"],
        "tls": { "implicit": false }
      },
      "pop3s": {
        "bind": ["0.0.0.0:995"],
        "tls": { "implicit": true }
      },
      "managesieve": {
        "bind": ["0.0.0.0:4190"],
        "tls": { "implicit": false }
      },
      "http": {
        "bind": ["0.0.0.0:8080"],
        "tls": { "implicit": false }
      },
      "https": {
        "bind": ["0.0.0.0:443"],
        "tls": { "implicit": true }
      }
    }
  },
  "storage": {
    "data": { "@type": "rocksdb", "path": "/var/lib/stalwart/data" },
    "blob": { "@type": "rocksdb", "path": "/var/lib/stalwart/blob" },
    "full-text": { "@type": "rocksdb", "path": "/var/lib/stalwart/fts" },
    "lookup": { "@type": "rocksdb", "path": "/var/lib/stalwart/lookup" }
  },
  "queue": {
    "@type": "rocksdb",
    "path": "/var/lib/stalwart/queue"
  },
  "directory": {
    "@type": "internal"
  },
  "authentication": {
    "@type": "internal"
  }
}
